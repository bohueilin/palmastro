<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and below (android:fullBackupContent).
     PalmAstro data is sensitive-by-design (PRD §26/§27): palm-derived data must never
     leave the device, so ALL app data is excluded from cloud backup. Belt-and-braces
     alongside android:allowBackup="false". -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
