<?xml version="1.0" encoding="utf-8"?>
<!-- Release network security policy: HTTPS only, system trust store only.
     Development exceptions (cleartext, user certificates) live exclusively in the
     debug source-set overlay at app/src/debug/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
