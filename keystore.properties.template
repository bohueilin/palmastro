# Copy this file to keystore.properties (repo root) and fill in values.
# NEVER commit keystore.properties or the keystore itself to version control
# (both are git-ignored).
#
# This keystore is the Play App Signing UPLOAD key (keystore/palmastro-upload.jks);
# Google Play holds the actual app signing key. storeFile is resolved relative to
# the app module directory (app/), hence the leading "../".
storeFile=../keystore/palmastro-upload.jks
storePassword=
keyAlias=palmastro-upload
keyPassword=
